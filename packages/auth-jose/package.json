{
  "name": "@comity/auth-jose",
  "version": "0.9.1",
  "description": "JOSE-backed token service implementing @comity/auth token contracts.",
  "type": "module",
  "private": false,
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "comity": {
    "layer": "technology-adapter",
    "implements": "@comity/auth"
  },
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "comity",
    "comityjs",
    "auth",
    "authentication",
    "jose",
    "jwt",
    "refresh-token",
    "security",
    "session",
    "token",
    "typescript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --ext .ts src"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./observers": {
      "types": "./dist/observers/index.d.ts",
      "default": "./dist/observers/index.js"
    },
    "./setup": {
      "types": "./dist/setup/index.d.ts",
      "default": "./dist/setup/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "observers": [
        "./dist/observers/index.d.ts"
      ],
      "setup": [
        "./dist/setup/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@comity/auth": "workspace:*",
    "@comity/auth-tokens": "workspace:*",
    "jose": "^6.0.0"
  },
  "dependencies": {
    "@comity/auth": "workspace:*",
    "@comity/auth-tokens": "workspace:*",
    "@comity/composition": "workspace:*",
    "@comity/primitives": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jose": "^6.2.13",
    "typescript": "^5.9.3"
  }
}
