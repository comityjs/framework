{
  "name": "@comity/primitives",
  "version": "0.9.2",
  "description": "Foundational primitives shared across Comity packages: dependency injection, errors, results, lifecycle, and time.",
  "type": "module",
  "private": false,
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "comity": {
    "layer": "primitives"
  },
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "comity",
    "comityjs",
    "dependency-injection",
    "errors",
    "lifecycle",
    "primitives",
    "result",
    "time",
    "typescript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --ext .ts src"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./di": {
      "types": "./dist/di/index.d.ts",
      "default": "./dist/di/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "default": "./dist/lifecycle/index.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "default": "./dist/result/index.js"
    },
    "./time": {
      "types": "./dist/time/index.d.ts",
      "default": "./dist/time/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "di": [
        "./dist/di/index.d.ts"
      ],
      "errors": [
        "./dist/errors/index.d.ts"
      ],
      "lifecycle": [
        "./dist/lifecycle/index.d.ts"
      ],
      "result": [
        "./dist/result/index.d.ts"
      ],
      "time": [
        "./dist/time/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
