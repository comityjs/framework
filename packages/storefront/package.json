{
  "name": "@comity/storefront",
  "version": "0.9.1",
  "description": "Storefront page composition capability module for Comity.",
  "type": "module",
  "private": false,
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "comity": {
    "layer": "core"
  },
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "comity",
    "comityjs",
    "e-commerce",
    "ecommerce",
    "storefront",
    "typescript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --ext .ts src"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./setup": {
      "types": "./dist/setup/index.d.ts",
      "default": "./dist/setup/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "errors": [
        "./dist/errors/index.d.ts"
      ],
      "setup": [
        "./dist/setup/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/catalog": "workspace:*",
    "@comity/composition": "workspace:*",
    "@comity/content": "workspace:*",
    "@comity/primitives": "workspace:*",
    "@comity/search": "workspace:*",
    "@comity/taxonomy": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
