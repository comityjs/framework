{
  "name": "@comity/order-sql",
  "version": "0.0.0",
  "description": "PostgreSQL implementation of the @comity/order repository with ADR-029 optimistic concurrency",
  "type": "module",
  "private": true,
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "comity": {
    "layer": "integration-adapter"
  },
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "comity",
    "adapter",
    "optimistic-concurrency",
    "order",
    "postgresql",
    "sql",
    "typescript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --ext .ts src"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {}
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/order": "workspace:^",
    "@comity/organization": "workspace:^",
    "@comity/pricing": "workspace:^",
    "@comity/primitives": "workspace:^",
    "@comity/sql": "workspace:^"
  },
  "devDependencies": {
    "@comity/sql-kysely": "workspace:^",
    "@types/node": "^24.19.2",
    "kysely": "^0.28.19",
    "pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
