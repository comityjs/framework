{
  "name": "@comity/html-preact",
  "version": "0.9.3",
  "description": "Preact module for server-rendered applications with Comity framework",
  "type": "module",
  "private": false,
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "comity": {
    "layer": "technology-adapter",
    "implements": "@comity/html"
  },
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "comity",
    "comityjs",
    "framework",
    "http",
    "javascript",
    "preact",
    "rendering",
    "typescript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --ext .ts src"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./streaming": {
      "types": "./dist/streaming/index.d.ts",
      "node": "./dist/streaming/node/index.js",
      "default": "./dist/streaming/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "streaming": [
        "./dist/streaming/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@comity/html": "workspace:^",
    "preact": "^10.0.0"
  },
  "dependencies": {
    "@comity/html": "workspace:^",
    "preact-render-to-string": "^6.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "preact": "^10.29.8",
    "typescript": "^5.9.3"
  }
}
