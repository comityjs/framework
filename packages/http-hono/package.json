{
  "name": "@comity/http-hono",
  "version": "0.9.3",
  "description": "Hono HTTP adapter for Comity framework applications",
  "type": "module",
  "private": false,
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "comity": {
    "layer": "technology-adapter",
    "implements": "@comity/http"
  },
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "comity",
    "comityjs",
    "adapter",
    "framework",
    "hono",
    "http",
    "typescript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --ext .ts src"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup/index.d.ts",
      "default": "./dist/setup/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "setup": [
        "./dist/setup/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@comity/composition": "workspace:^",
    "@comity/http": "workspace:^",
    "@comity/primitives": "workspace:^",
    "hono": "^4.12"
  },
  "dependencies": {
    "@comity/composition": "workspace:^",
    "@comity/http": "workspace:^",
    "@comity/primitives": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "hono": "^4.13.17",
    "typescript": "^5.9.3"
  }
}
